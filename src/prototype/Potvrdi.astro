---
// PROTOTYPE — Concept "Potvrdi" (from Fable). The site behaves like Aura: it proposes (italic draft), you confirm
// (upright, stamped) or reject (next draft). Proposals auto-confirm after a few seconds so nobody is blocked.
// R&D proposals never confirm — "waiting for evidence". The agent can say no (refusal demo).
import { work, people, contact, legal } from './content';

const heroDrafts = [
  'Softver koji zna reći „ne”.',
  'Softver za sportsku industriju.',
  'Do sada smo gradili za druge. Sada gradimo i svoje.',
];
const pillars = [
  { title: 'Sportski podaci u stvarnom vremenu', why: 'jer je to najveći dio našeg rada', body: 'Prikupljanje koeficijenata iz više izvora, uparivanje susreta, cijena po klijentu i isporuka u standardnom formatu — prosječno za 0,4 ms. Za SportLive, spremno za pilot.' },
  { title: 'AI agenti koji traže potvrdu', why: 'jer bez potvrde ne djeluju', body: 'Agenti koji rade u rezervacijama, kanalima prodaje i državnim registrima. Agent predlaže, čovjek potvrđuje, poslužitelj provjerava da je provedeno baš ono što je potvrđeno.' },
];
const chat = [
  { who: 'Domaćin', text: 'Prijavi goste iz sobe 2 u eVisitor.' },
  { who: 'Agent', text: 'Prijedlog: prijava 2 gosta, boravak 14.–17. 10. Potvrđujete?', kind: 'prop' },
  { who: 'Domaćin', text: 'Potvrđujem.' },
  { who: 'Agent', text: 'Ne mogu prijaviti drugog gosta bez datuma rođenja. Želite li ga unijeti?', kind: 'no' },
  { who: 'Domaćin', text: '12. 3. 1990.' },
  { who: 'Agent', text: 'Prijavljeno. Poslužitelj je provjerio: prijavljeno je točno ono što ste potvrdili.', kind: 'ok' },
];
const stampOf: Record<string, string> = { 'U produkciji': 'potvrđeno · u produkciji', 'Spremno za pilot': 'potvrđeno · spremno za pilot', 'U razvoju': 'u izradi', 'U tijeku': 'u tijeku' };
---

<div class="pt min-h-screen bg-[#F6F1E7] font-public text-[#1C1A17] selection:bg-[#2F5D3A] selection:text-white">
  <header class="mx-auto flex max-w-[1100px] items-center justify-between px-6 py-6">
    <a href="#" class="font-fraunces text-xl font-semibold">Upanishad</a>
    <nav class="hidden gap-6 text-sm text-[#1C1A17]/60 md:flex">
      <a href="#pt-what" class="hover:text-[#1C1A17]">Što radimo</a><a href="#pt-work" class="hover:text-[#1C1A17]">Radovi</a>
      <a href="#pt-rnd" class="hover:text-[#1C1A17]">Istraživanje</a><a href="#pt-about" class="hover:text-[#1C1A17]">O nama</a>
    </nav>
    <span class="text-sm text-[#1C1A17]/50"><b class="text-[#1C1A17]">HR</b> EN</span>
  </header>

  <main class="mx-auto max-w-[1100px] px-6">
    <section class="pt-16 md:pt-28">
      <div class="pt-prop" data-auto="6" data-drafts={JSON.stringify(heroDrafts)}>
        <p class="pt-label">Prijedlog · naslov stranice <span class="pt-why">zašto: prvo što ćete pročitati</span></p>
        <h1 class="pt-body mt-4 max-w-5xl font-fraunces text-[clamp(2.8rem,7.5vw,6.8rem)] leading-[0.98] tracking-[-0.02em]">{heroDrafts[0]}</h1>
        <div class="pt-actions">
          <button data-act="ok" class="pt-btn-ok">Potvrdi</button><button data-act="no" class="pt-btn-no">Odbaci</button>
          <span class="pt-count"></span>
        </div>
        <p class="pt-stamp"></p>
      </div>
      <div class="pt-prop mt-16" data-auto="8">
        <p class="pt-label">Prijedlog · podnaslov</p>
        <p class="pt-body mt-3 max-w-3xl font-fraunces text-2xl leading-snug md:text-3xl">Upanishad gradi softver za sportsku industriju, AI agente koji ne djeluju bez vaše potvrde i vlastitu tehnologiju za predviđanje kretanja igrača.</p>
        <div class="pt-actions"><button data-act="ok" class="pt-btn-ok">Potvrdi</button><span class="pt-count"></span></div>
        <p class="pt-stamp"></p>
      </div>
    </section>

    <section id="pt-what" class="scroll-mt-8 pt-40">
      {pillars.map((p, i) => (
        <div class="pt-prop mb-24 grid gap-6 md:grid-cols-[160px_1fr]" data-auto="3" data-inview>
          <p class="pt-num font-fraunces text-6xl text-[#1C1A17]/15">0{i + 1}</p>
          <div>
            <p class="pt-label">Prijedlog <span class="pt-why">zašto: {p.why}</span></p>
            <h2 class="pt-body mt-3 font-fraunces text-4xl leading-tight md:text-5xl">{p.title}</h2>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[#1C1A17]/75">{p.body}</p>
            <div class="pt-actions"><button data-act="ok" class="pt-btn-ok">Potvrdi</button><span class="pt-count"></span></div>
            <p class="pt-stamp"></p>
          </div>
        </div>
      ))}

      <div class="grid gap-10 rounded-sm border border-[#1C1A17]/15 bg-[#FBF8F2] p-6 md:grid-cols-[1fr_1.2fr] md:p-10">
        <div>
          <p class="pt-label">Aura · razgovor u produkciji (ilustracija)</p>
          <h3 class="mt-3 font-fraunces text-4xl leading-tight">Agent koji zna reći „ne”.</h3>
          <p class="mt-4 text-[#1C1A17]/70">Domaćin vodi kuću za odmor razgovorom na hrvatskom. Kad podatak nedostaje, agent ne nagađa — staje i pita.</p>
          <button id="pt-next" class="pt-btn-ok mt-8">Dalje →</button>
        </div>
        <div id="pt-chat" class="space-y-3" aria-live="polite">
          {chat.map((m, i) => (
            <div data-i={i} class:list={['pt-msg', i > 0 && 'hidden', m.who === 'Domaćin' ? 'ml-auto bg-[#1C1A17] text-[#F6F1E7]' : 'bg-white', m.kind === 'no' && 'pt-msg-no', m.kind === 'ok' && 'pt-msg-ok', m.kind === 'prop' && 'font-fraunces italic']}>
              <span class="block text-[10px] uppercase tracking-[0.16em] opacity-60">{m.who}</span>{m.text}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="pt-work" class="scroll-mt-8 pt-40">
      <p class="pt-label">Radovi</p>
      <div class="mt-6 border-t border-[#1C1A17]/20">
        {work.map((w) => (
          <article class="grid gap-4 border-b border-[#1C1A17]/15 py-10 md:grid-cols-[1fr_1.4fr_auto] md:items-start">
            <div><h3 class="font-fraunces text-4xl">{w.client}</h3><p class="mt-1 italic text-[#1C1A17]/60">{w.kind}</p></div>
            <p class="text-lg leading-relaxed text-[#1C1A17]/75">{w.body}</p>
            <span class:list={['pt-chip', w.status === 'U produkciji' || w.status === 'Spremno za pilot' ? 'pt-chip-ok' : 'pt-chip-wait']}>{stampOf[w.status]}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="pt-rnd" class="scroll-mt-8 pt-40">
      <p class="pt-label">Istraživanje</p>
      <h2 class="mt-3 max-w-4xl font-fraunces text-5xl leading-[1.02] md:text-6xl">Ovi prijedlozi se ne potvrđuju sami. <span class="italic text-[#8A8378]">Čekaju dokaze.</span></h2>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {[
          { code: 'OTISAK', title: 'Digitalni otisak kretanja igrača', body: 'TV snimka ne prikazuje igrače bez lopte, pa je 40–64 % položaja procjena. Hipoteza: „otisak” kretanja naučen iz prošlih utakmica smanjuje pogrešku predviđanja 1–4 s unaprijed za barem 10 %.' },
          { code: 'KLIMA', title: 'Prediktivno upravljanje toplinom', body: 'Hipoteza: vodeni krug s više spremnika topline, vođen vremenskom prognozom, može zamijeniti dizalicu topline u stakleniku. Fiziku mjere i potvrđuju fakulteti.' },
        ].map((r) => (
          <div class="border border-dashed border-[#1C1A17]/30 p-7">
            <p class="pt-label">Prijedlog · {r.code}</p>
            <h3 class="mt-3 font-fraunces text-3xl italic text-[#1C1A17]/70">{r.title}</h3>
            <p class="mt-4 leading-relaxed text-[#1C1A17]/70">{r.body}</p>
            <p class="mt-6 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.16em] text-[#2E4A7D]"><span class="size-2 animate-pulse rounded-full bg-[#2E4A7D]"></span>čeka dokaze · nije potvrđeno</p>
          </div>
        ))}
      </div>
    </section>

    <section id="pt-about" class="scroll-mt-8 pt-40">
      <p class="pt-label">O nama</p>
      <div class="mt-6 grid gap-12 md:grid-cols-2">
        {people.map((p) => (
          <div><h3 class="font-fraunces text-4xl">{p.name}</h3><p class="mt-1 text-sm uppercase tracking-[0.14em] text-[#2F5D3A]">{p.role}</p><p class="mt-4 text-lg text-[#1C1A17]/75">{p.body}</p></div>
        ))}
      </div>
      <p class="mt-16 max-w-2xl text-[#1C1A17]/60">Aljmaš, na ušću Drave u Dunav, od 2024. Upanishad je sanskrtska riječ — otprilike „sjesti blizu”.</p>
    </section>

    <section id="pt-contact" class="pt-40 pb-32">
      <h2 class="font-fraunces text-6xl md:text-8xl">Razgovarajmo.</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div class="space-y-6">
          <div>
            <p class="pt-label">Prijedlog · prikazati e-poštu posjetitelju</p>
            <a data-r={contact.emailReversed} href="#" class="pt-reveal mt-3 inline-flex items-center gap-3 font-fraunces text-3xl"><span data-slot class="italic text-[#8A8378]">e-pošta skrivena</span><span class="pt-btn-ok text-sm not-italic">Potvrdi</span></a>
          </div>
          <div>
            <p class="pt-label">Prijedlog · prikazati telefon</p>
            <a data-r={contact.phoneReversed} data-kind="tel" href="#" class="pt-reveal mt-3 inline-flex items-center gap-3 font-fraunces text-3xl"><span data-slot class="italic text-[#8A8378]">telefon skriven</span><span class="pt-btn-ok text-sm not-italic">Potvrdi</span></a>
          </div>
        </div>
        <form id="pt-form" class="space-y-3 border border-[#1C1A17]/15 bg-[#FBF8F2] p-6" novalidate>
          <p class="pt-label">Ili zatražite poziv</p>
          <input name="name" placeholder="Ime" class="w-full border-b border-[#1C1A17]/30 bg-transparent py-2 outline-none focus:border-[#1C1A17]" />
          <input name="reach" placeholder="E-pošta ili telefon" class="w-full border-b border-[#1C1A17]/30 bg-transparent py-2 outline-none focus:border-[#1C1A17]" />
          <textarea name="msg" rows="2" placeholder="O čemu se radi?" class="w-full border-b border-[#1C1A17]/30 bg-transparent py-2 outline-none focus:border-[#1C1A17]"></textarea>
          <button class="pt-btn-ok">Pošalji</button>
          <p id="pt-form-out" class="min-h-6 text-sm"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="border-t border-[#1C1A17]/15">
    <div class="mx-auto grid max-w-[1100px] gap-6 px-6 py-10 text-xs leading-relaxed text-[#1C1A17]/55 md:grid-cols-3">
      <div><b class="text-[#1C1A17]">{legal.name}</b><br />{legal.address}</div>
      <div>{legal.court}, MBS {legal.mbs} · OIB {legal.oib}<br />{legal.capital} · {legal.director}</div>
      <div class="md:text-right">{legal.bank}<br /><a href="#" class="underline">Za tim</a></div>
    </div>
  </footer>
</div>

<style is:global>
  .pt-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: #8A8378; }
  .pt-why { margin-left: 0.75rem; text-transform: none; letter-spacing: 0; font-style: italic; opacity: 0.8; }
  .pt-prop .pt-body { font-style: italic; color: #8A8378; font-weight: 380; transition: color 220ms, font-weight 220ms; }
  .pt-prop[data-state='ok'] .pt-body { font-style: normal; color: #1C1A17; font-weight: 560; }
  .pt-prop[data-state='ok'] .pt-num { color: #2F5D3A; }
  .pt-actions { margin-top: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
  .pt-prop[data-state='ok'] .pt-actions { display: none; }
  .pt-btn-ok, .pt-btn-no { border-radius: 999px; padding: 0.55rem 1.1rem; font-size: 0.85rem; font-family: "Public Sans Variable", sans-serif; font-weight: 600; font-style: normal; }
  .pt-btn-ok { background: #2F5D3A; color: #F6F1E7; }
  .pt-btn-ok:hover { background: #1C1A17; }
  .pt-btn-no { border: 1px solid rgb(28 26 23 / 0.25); color: #1C1A17; }
  .pt-btn-no:hover { border-color: #B8441F; color: #B8441F; }
  .pt-count { font-size: 12px; color: #8A8378; margin-left: 0.5rem; }
  .pt-stamp { margin-top: 0.9rem; font: 500 11px "JetBrains Mono Variable", monospace; color: #2E4A7D; letter-spacing: 0.04em; min-height: 1em; }
  .pt-prop[data-state='ok'] .pt-body:hover { text-decoration: underline; text-decoration-color: #2F5D3A; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .pt-msg { width: fit-content; max-width: 88%; padding: 0.7rem 1rem; border-radius: 0.75rem; box-shadow: 0 1px 0 rgb(28 26 23 / 0.06); animation: pt-in 260ms ease-out; }
  .pt-msg-no { background: #FBE9E2 !important; color: #8E2F12; border: 1px solid #B8441F; }
  .pt-msg-ok { background: #E6EFE5 !important; color: #1F4228; }
  @keyframes pt-in { from { opacity: 0; transform: translateY(6px); } }
  .pt-chip { white-space: nowrap; border-radius: 999px; padding: 0.35rem 0.8rem; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; }
  .pt-chip-ok { background: #2F5D3A; color: #F6F1E7; }
  .pt-chip-wait { border: 1px dashed #8A8378; color: #8A8378; }
  .pt-reveal[data-revealed] [data-slot] { font-style: normal; color: #1C1A17; }
  .pt-reveal[data-revealed] .pt-btn-ok { display: none; }
  @media (prefers-reduced-motion: reduce) { .pt-msg { animation: none; } }
</style>

<script>
  const ts = () => new Date().toTimeString().slice(0, 8);

  function confirm(prop: HTMLElement, auto: boolean) {
    if (prop.dataset.state === 'ok') return;
    prop.dataset.state = 'ok';
    clearInterval(Number(prop.dataset.timer));
    const stamp = prop.querySelector<HTMLElement>('.pt-stamp');
    if (stamp) stamp.textContent = `potvrđeno ${ts()}${auto ? ' · automatski' : ''} · prikazano = potvrđeno ✓`;
  }

  function arm(prop: HTMLElement) {
    if (prop.dataset.state === 'ok' || prop.dataset.timer) return;
    let left = Number(prop.dataset.auto ?? 6);
    const count = prop.querySelector<HTMLElement>('.pt-count');
    const tick = () => {
      if (count) count.textContent = `automatski potvrđujem za ${left} s`;
      if (left-- <= 0) confirm(prop, true);
    };
    tick();
    prop.dataset.timer = String(setInterval(tick, 1000));
  }

  document.querySelectorAll<HTMLElement>('.pt .pt-prop').forEach((prop) => {
    const drafts: string[] = prop.dataset.drafts ? JSON.parse(prop.dataset.drafts) : [];
    let d = 0;
    prop.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) => b.addEventListener('click', () => {
      if (b.dataset.act === 'ok') return confirm(prop, false);
      d = (d + 1) % drafts.length;
      prop.querySelector('.pt-body')!.textContent = drafts[d];
      const stamp = prop.querySelector<HTMLElement>('.pt-stamp');
      if (stamp) stamp.textContent = `odbačeno ${ts()} · novi prijedlog`;
      clearInterval(Number(prop.dataset.timer)); delete prop.dataset.timer; arm(prop);
    }));
  });

  // Arm proposals when they scroll into view (hero ones immediately when visible).
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    const el = e.target as HTMLElement;
    if (e.isIntersecting && el.closest<HTMLElement>('[data-variant]')?.hidden === false) arm(el);
  }), { threshold: 0.6 });
  document.querySelectorAll('.pt .pt-prop').forEach((p) => io.observe(p));
  addEventListener('variantchange', () => document.querySelectorAll('.pt .pt-prop').forEach((p) => { io.unobserve(p); io.observe(p); }));

  // Aura conversation step-through.
  let step = 0;
  const msgs = [...document.querySelectorAll<HTMLElement>('#pt-chat [data-i]')];
  const next = document.getElementById('pt-next') as HTMLButtonElement;
  next.addEventListener('click', () => {
    step = step + 1 >= msgs.length ? 0 : step + 1;
    msgs.forEach((m, i) => m.classList.toggle('hidden', i > step));
    next.textContent = step === msgs.length - 1 ? 'Ispočetka ↺' : 'Dalje →';
  });

  // Refusal demo: the form never sends anything; it only shows that the site can say no.
  const form = document.getElementById('pt-form') as HTMLFormElement;
  const out = document.getElementById('pt-form-out')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const reach = (form.elements.namedItem('reach') as HTMLInputElement).value.trim();
    if (!reach) {
      out.style.color = '#B8441F';
      out.textContent = 'Ne mogu poslati: nemamo kako vam se javiti. Dodajte e-poštu ili telefon.';
    } else {
      out.style.color = '#2F5D3A';
      out.textContent = 'Prijedlog spreman za slanje. (Prototip — ništa nije poslano.)';
    }
  });
</script>
