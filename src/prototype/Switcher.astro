---
// PROTOTYPE — floating variant switcher. Rendered only in `astro dev`.
interface Props {
  variants: { key: string; name: string }[];
}
const { variants } = Astro.props;
---

<div
  id="proto-switcher"
  data-variants={JSON.stringify(variants)}
  class="fixed bottom-5 left-1/2 z-[9999] flex -translate-x-1/2 items-center gap-1 rounded-full border border-white/20 bg-fuchsia-600 p-1 font-mono text-xs text-white shadow-2xl shadow-black/40"
>
  <button data-dir="-1" class="grid size-8 place-items-center rounded-full hover:bg-white/20" aria-label="Prethodna varijanta">←</button>
  <span id="proto-label" class="min-w-52 px-2 text-center"></span>
  <button data-dir="1" class="grid size-8 place-items-center rounded-full hover:bg-white/20" aria-label="Sljedeća varijanta">→</button>
</div>

<script>
  const bar = document.getElementById('proto-switcher')!;
  const label = document.getElementById('proto-label')!;
  const variants: { key: string; name: string }[] = JSON.parse(bar.dataset.variants!);

  function show(key: string) {
    const v = variants.find((x) => x.key === key) ?? variants[0];
    document.querySelectorAll<HTMLElement>('[data-variant]').forEach((el) => {
      el.hidden = el.dataset.variant !== v.key;
    });
    label.textContent = `${v.key} — ${v.name}`;
    const url = new URL(location.href);
    url.searchParams.set('variant', v.key);
    history.replaceState(null, '', url);
    window.scrollTo({ top: 0 });
    window.dispatchEvent(new CustomEvent('variantchange', { detail: v.key }));
  }

  function step(dir: number) {
    const current = new URL(location.href).searchParams.get('variant') ?? variants[0].key;
    const i = variants.findIndex((x) => x.key === current);
    show(variants[(i + dir + variants.length) % variants.length].key);
  }

  bar.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
    b.addEventListener('click', () => step(Number(b.dataset.dir))),
  );
  window.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, [contenteditable]')) return;
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  show(new URL(location.href).searchParams.get('variant') ?? variants[0].key);
</script>
