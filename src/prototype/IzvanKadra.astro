---
// PROTOTYPE — Concept "Izvan kadra" (from Fable). The cursor is a broadcast camera: whatever is inside
// the frame is observed (solid), everything outside is an estimate (amber halftone, dashed rings that grow
// with time unseen). The same solid/estimate grammar carries services, work, R&D and contact.
import { work, people, contact, legal } from './content';

const statusClass: Record<string, string> = {
  'U produkciji': 'ik-solid',
  'Spremno za pilot': 'ik-solid',
  'U razvoju': 'ik-est',
  'U tijeku': 'ik-est ik-est-grey',
};
const nav = [['Što radimo', '#ik-what'], ['Radovi', '#ik-work'], ['Istraživanje', '#ik-rnd'], ['O nama', '#ik-about']];
---

<div class="ik min-h-screen bg-[#0A0A0B] font-archivo text-[#ECEAE3] selection:bg-[#F2A900] selection:text-black">
  <header class="fixed inset-x-0 top-0 z-40 bg-gradient-to-b from-[#0A0A0B] via-[#0A0A0B]/80 to-transparent">
    <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-5 md:px-12">
      <a href="#" class="flex items-center gap-3 text-[15px] font-semibold tracking-tight">
        <span class="ik-corners block size-5 text-[#ECEAE3] [--cl:6px]"></span>upanishad
      </a>
      <nav class="hidden gap-9 font-mono text-[11px] uppercase tracking-[0.18em] text-[#ECEAE3]/60 md:flex">
        {nav.map(([n, h]) => <a href={h} class="hover:text-[#ECEAE3]">{n}</a>)}
      </nav>
      <div class="flex items-center gap-5 font-mono text-[11px] uppercase tracking-[0.18em]">
        <span class="text-[#ECEAE3]/50"><b class="font-medium text-[#ECEAE3]">HR</b> EN</span>
        <a href="#ik-contact" class="ik-cta-est px-3 py-1.5">Kontakt</a>
      </div>
    </div>
  </header>

  <section id="ik-hero" class="relative h-[100svh] min-h-[680px] overflow-hidden">
    <canvas id="ik-canvas" class="absolute inset-0 size-full" aria-hidden="true"></canvas>

    <div id="ik-frame" class="pointer-events-none absolute left-0 top-0 z-20 will-change-transform" aria-hidden="true">
      <div class="ik-corners absolute inset-0 text-[#ECEAE3] [--cl:26px] [--cw:2px]"></div>
      <div class="absolute -top-6 left-0 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.2em] text-[#ECEAE3]/80">
        <span class="size-1.5 rounded-full bg-[#ff3b30]"></span>Kamera 1 · uživo
      </div>
      <div id="ik-tc" class="absolute -top-6 right-0 font-mono text-[10px] tracking-[0.2em] text-[#ECEAE3]/60">00:23:41:00</div>
    </div>

    <div class="relative z-10 mx-auto flex h-full max-w-[1440px] flex-col justify-center px-6 pt-10 md:px-12">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#ECEAE3]/50">Softver za sportsku industriju</p>
      <h1 class="ik-dual relative mt-6 text-[clamp(3.2rem,9.4vw,10rem)] font-[760] leading-[0.88] tracking-[-0.025em] [font-stretch:78%]">
        <span class="ik-est block [--dp:5px] [--dr:1.5px]" aria-hidden="true">Vidimo i ono<br />što kamera<br />ne vidi.</span>
        <span class="ik-solid absolute inset-0" data-framed>Vidimo i ono<br />što kamera<br />ne vidi.</span>
      </h1>
      <div class="ik-dual relative mt-8 max-w-[34rem] text-lg leading-snug md:text-xl">
        <p class="ik-est [--dp:2px] [--dr:0.75px]" aria-hidden="true">Podaci u stvarnom vremenu, AI agenti koji traže potvrdu prije nego što djeluju i istraživanje koje uči predvidjeti igrače izvan kadra.</p>
        <p class="ik-solid absolute inset-0" data-framed>Podaci u stvarnom vremenu, AI agenti koji traže potvrdu prije nego što djeluju i istraživanje koje uči predvidjeti igrače izvan kadra.</p>
      </div>
      <div class="mt-10 flex flex-wrap gap-3 font-mono text-xs uppercase tracking-[0.16em]">
        <a href="#ik-contact" class="ik-cta-solid px-5 py-3.5">Razgovarajmo</a>
        <a href="#ik-rnd" class="ik-cta-est px-5 py-3.5">Pogledajte izvan kadra</a>
      </div>
    </div>

    <div class="absolute inset-x-0 bottom-0 z-10 border-t border-[#ECEAE3]/10 bg-[#0A0A0B]/70 backdrop-blur-sm">
      <div class="mx-auto flex max-w-[1440px] flex-wrap gap-x-8 gap-y-1 px-6 py-3 font-mono text-[11px] tracking-[0.08em] text-[#ECEAE3]/60 md:px-12">
        <span>kadar <b id="ik-cov" class="font-medium text-[#ECEAE3]">23</b> % terena</span>
        <span><b id="ik-estc" class="font-medium text-[#F2A900]">15</b>/22 igrača procijenjeno</span>
        <span>horizont predviđanja 1–4 s</span>
        <span class="ml-auto hidden text-[#ECEAE3]/35 md:inline">pomaknite miš · ilustracija</span>
      </div>
    </div>
  </section>

  <section id="ik-what" class="mx-auto max-w-[1440px] scroll-mt-16 px-6 py-28 md:px-12">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#ECEAE3]/50">01 — Što radimo</p>

    <div class="mt-16 grid items-center gap-10 lg:grid-cols-[1.25fr_1fr]">
      <div class="ik-match relative aspect-[16/9]" data-inview>
        <div class="ik-corners absolute inset-[12%_8%_12%_34%] text-[#ECEAE3] [--cl:18px]"></div>
        <div class="absolute left-0 top-[14%] space-y-[11%] font-mono text-[13px] md:text-sm">
          <p class="ik-src ik-est [--dp:2px] [--dr:0.8px]">HNK Hajduk Split vs GNK Dinamo</p>
          <p class="ik-src ik-est [--dp:2px] [--dr:0.8px] [transition-delay:120ms]">Hajduk – Dinamo Zg</p>
          <p class="ik-src ik-est [--dp:2px] [--dr:0.8px] [transition-delay:240ms]">HAJ v DIN · 1X2</p>
        </div>
        <div class="ik-rec absolute inset-[12%_8%_12%_34%] grid place-items-center text-center">
          <div>
            <p class="font-mono text-[11px] tracking-[0.2em] text-[#ECEAE3]/50">ID 48121</p>
            <p class="mt-2 text-2xl font-semibold [font-stretch:85%] md:text-4xl">Hajduk – Dinamo</p>
            <p class="mt-2 font-mono text-sm text-[#9BE564]">1X2 · 2,40 / 3,10 / 2,95</p>
          </div>
        </div>
      </div>
      <div>
        <h2 class="text-4xl font-[720] leading-[0.95] tracking-tight [font-stretch:82%] md:text-6xl">Mnogo izvora.<br />Jedan zapis.</h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-[#ECEAE3]/70">Isti susret stiže od desetak pružatelja pod desetak imena. Uparujemo ga, određujemo cijenu za svakog klijenta i isporučujemo u standardnom formatu — prosječno za 0,4 ms.</p>
        <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.18em] text-[#ECEAE3]/40">Kotlin · Aeron · Kubernetes · TimescaleDB</p>
      </div>
    </div>

    <div class="mt-32 grid items-center gap-10 lg:grid-cols-[1fr_1.25fr]">
      <div class="lg:order-2">
        <div id="ik-chat" data-state="proposed" class="relative mx-auto aspect-[16/10] max-w-[640px] p-[7%]">
          <div class="ik-corners absolute inset-0 text-[#ECEAE3] [--cl:18px]"></div>
          <p class="ml-auto w-fit max-w-[80%] rounded-sm bg-[#ECEAE3]/10 px-4 py-2.5 text-[15px]">Spusti cijenu za idući vikend 10 %.</p>
          <div class="mt-5 max-w-[88%]">
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#F2A900]" data-label>Prijedlog agenta</p>
            <div class="ik-dual relative mt-2 font-mono text-[15px] md:text-lg">
              <p class="ik-est [--dp:2px] [--dr:0.8px]" data-proposal>sub 120 € → 108 € · ned 120 € → 108 €</p>
              <p class="ik-solid absolute inset-0 opacity-0 transition-opacity duration-200" data-committed>sub 120 € → 108 € · ned 120 € → 108 €</p>
            </div>
            <div class="mt-5 flex gap-2 font-mono text-[11px] uppercase tracking-[0.16em]" data-buttons>
              <button data-act="confirm" class="ik-cta-solid px-4 py-2.5">Potvrdi</button>
              <button data-act="reject" class="ik-cta-est px-4 py-2.5">Odbaci</button>
            </div>
            <p class="mt-5 hidden font-mono text-[11px] leading-relaxed text-[#9BE564]" data-stamp></p>
          </div>
        </div>
      </div>
      <div class="lg:order-1">
        <h2 class="text-4xl font-[720] leading-[0.95] tracking-tight [font-stretch:82%] md:text-6xl">Agent predlaže.<br />Vi potvrđujete.</h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-[#ECEAE3]/70">AI agenti koji rade u stvarnim sustavima — rezervacije, kanali prodaje, državni registri. Dok ga ne potvrdite, prijedlog je samo procjena. Poslužitelj provjerava da je provedeno baš ono što ste potvrdili.</p>
        <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.18em] text-[#ECEAE3]/40">MCP · TypeScript · PostgreSQL</p>
      </div>
    </div>

    <div class="mt-32 grid items-end gap-10 lg:grid-cols-[1.25fr_1fr]">
      <p class="ik-est text-[clamp(5rem,17vw,15rem)] font-[800] leading-[0.8] tracking-[-0.04em] [--dp:6px] [--dr:1.9px] [font-stretch:70%]">40–64 %</p>
      <div>
        <h2 class="text-4xl font-[720] leading-[0.95] tracking-tight [font-stretch:82%] md:text-6xl">Ostatak je procjena.</h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-[#ECEAE3]/70">Toliko položaja igrača u TV snimci nije stvarno viđeno, nego procijenjeno. Gradimo vlastitu tehnologiju koja tu procjenu čini boljom.</p>
      </div>
    </div>
  </section>

  <section id="ik-work" class="scroll-mt-16 border-t border-[#ECEAE3]/10">
    <div class="mx-auto max-w-[1440px] px-6 py-28 md:px-12">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#ECEAE3]/50">02 — Radovi</p>
      {work.map((w, i) => (
        <article class="grid items-center gap-10 border-b border-[#ECEAE3]/10 py-14 md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
          <div class="relative grid aspect-video place-items-center px-8">
            <div class:list={['ik-corners absolute inset-0 [--cl:16px]', w.status === 'U produkciji' ? 'text-[#ECEAE3]' : 'text-[#ECEAE3]/40']}></div>
            <span class="absolute left-3 top-3 font-mono text-[10px] tracking-[0.2em] text-[#ECEAE3]/40">KADAR 0{i + 1}</span>
            <span class:list={['absolute right-3 top-3 font-mono text-[10px] uppercase tracking-[0.2em]', w.status === 'U produkciji' ? 'text-[#9BE564]' : 'text-[#F2A900]']}>{w.status}</span>
            <h3 class:list={['text-center font-[760] leading-[0.9] tracking-tight [font-stretch:75%] [--dp:4px] [--dr:1.2px]', w.client.length > 12 ? 'text-3xl md:text-4xl' : 'text-6xl md:text-7xl', statusClass[w.status]]}>{w.client}</h3>
          </div>
          <div>
            <p class="text-2xl font-semibold tracking-tight [font-stretch:90%]">{w.kind}</p>
            <p class="mt-4 max-w-xl text-lg leading-relaxed text-[#ECEAE3]/70">{w.body}</p>
            <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.16em] text-[#ECEAE3]/40">{w.role} · {w.facts.join(' · ')}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="ik-rnd" class="scroll-mt-16 border-t border-[#ECEAE3]/10">
    <div class="mx-auto max-w-[1440px] px-6 py-28 md:px-12">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#ECEAE3]/50">03 — Istraživanje</p>
      <h2 class="mt-8 max-w-4xl text-5xl font-[740] leading-[0.92] tracking-tight [font-stretch:80%] md:text-7xl">Do sada smo gradili za druge. Sada gradimo i svoje.</h2>

      <div class="mt-20 grid gap-12 lg:grid-cols-[1.3fr_1fr]">
        <figure>
          <svg id="ik-otisak" viewBox="0 0 640 340" class="w-full" role="img" aria-label="Predviđanje položaja igrača izvan kadra">
            <rect x="0.5" y="0.5" width="639" height="339" fill="none" stroke="#ECEAE3" stroke-opacity="0.12" />
            <line x1="320" y1="0" x2="320" y2="340" stroke="#ECEAE3" stroke-opacity="0.12" />
            <circle cx="320" cy="170" r="46" fill="none" stroke="#ECEAE3" stroke-opacity="0.12" />
            <rect x="0" y="0" width="300" height="340" fill="#ECEAE3" fill-opacity="0.04" />
            <g fill="none" stroke="#ECEAE3" stroke-width="2"><path d="M0 0h22M0 0v22M300 0h-22M300 0v22M0 340h22M0 340v-22M300 340h-22M300 340v-22" /></g>
            <text x="10" y="326" fill="#ECEAE3" fill-opacity="0.5" font-size="10" font-family="JetBrains Mono Variable" letter-spacing="2">U KADRU</text>
            <text x="630" y="326" text-anchor="end" fill="#F2A900" fill-opacity="0.7" font-size="10" font-family="JetBrains Mono Variable" letter-spacing="2">IZVAN KADRA</text>
            <path d="M40 280 C 120 270, 210 200, 300 170" fill="none" stroke="#ECEAE3" stroke-width="2.5" />
            <path id="ik-pred" d="M300 170 C 380 140, 470 120, 590 70" fill="none" stroke="#F2A900" stroke-width="2" stroke-dasharray="5 6" />
            <circle cx="300" cy="170" r="6" fill="#ECEAE3" />
            <ellipse id="ik-base" fill="none" stroke="#ECEAE3" stroke-opacity="0.45" stroke-dasharray="3 5" />
            <ellipse id="ik-goal" fill="#F2A900" fill-opacity="0.1" stroke="#F2A900" stroke-width="1.5" />
            <circle id="ik-pt" r="4" fill="#F2A900" />
          </svg>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-xs">
            <label for="ik-h" class="uppercase tracking-[0.18em] text-[#ECEAE3]/60">Horizont</label>
            <input id="ik-h" type="range" min="1" max="4" step="0.1" value="2" class="ik-range w-56" />
            <span><b id="ik-hv" class="text-[#ECEAE3]">2,0</b> s</span>
            <span class="text-[#ECEAE3]/50">bez otiska ±<b id="ik-bv">2,4</b> m</span>
            <span class="text-[#F2A900]">cilj s otiskom ±<b id="ik-gv">2,2</b> m</span>
          </div>
          <figcaption class="mt-4 max-w-xl text-sm leading-relaxed text-[#ECEAE3]/50">Cilj istraživanja je barem 10 % manja pogreška od predviđanja bez otiska. Rezultati još nisu poznati — ovo je ilustracija pitanja, ne odgovora.</figcaption>
        </figure>
        <div class="space-y-14">
          <article>
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#F2A900]">OTISAK · dokazivanje koncepta</p>
            <h3 class="mt-3 text-3xl font-[720] tracking-tight [font-stretch:85%]">Digitalni otisak kretanja igrača</h3>
            <p class="mt-3 text-lg leading-relaxed text-[#ECEAE3]/70">Svaki igrač se kreće na svoj način. Model iz prošlih utakmica uči taj „otisak” i koristi ga da predvidi gdje je igrač kojeg kamera ne vidi, 1–4 sekunde unaprijed.</p>
          </article>
          <article>
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#F2A900]">KLIMA · u pripremi</p>
            <h3 class="mt-3 text-3xl font-[720] tracking-tight [font-stretch:85%]">Prediktivno upravljanje toplinom</h3>
            <p class="mt-3 text-lg leading-relaxed text-[#ECEAE3]/70">Isti princip, drugi teren: softver upravlja vodenim krugom s više spremnika topline prema vremenskoj prognozi. Prošlost je izmjerena, plan je procjena.</p>
            <svg viewBox="0 0 400 110" class="mt-6 w-full" aria-hidden="true">
              <line x1="200" y1="0" x2="200" y2="110" stroke="#ECEAE3" stroke-opacity="0.3" />
              <text x="206" y="12" fill="#ECEAE3" fill-opacity="0.5" font-size="9" font-family="JetBrains Mono Variable" letter-spacing="1.5">SADA</text>
              <path d="M0 80 C 30 70, 50 40, 80 45 S 130 90, 160 70 S 190 50, 200 55" fill="none" stroke="#ECEAE3" stroke-width="2" />
              <path d="M200 55 C 220 60, 240 85, 270 80 S 320 30, 350 40 S 390 70, 400 65" fill="none" stroke="#F2A900" stroke-width="2" stroke-dasharray="4 5" />
            </svg>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="ik-about" class="scroll-mt-16 border-t border-[#ECEAE3]/10">
    <div class="mx-auto grid max-w-[1440px] gap-16 px-6 py-28 md:px-12 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#ECEAE3]/50">04 — O nama</p>
        <p class="mt-8 text-4xl font-[700] leading-[1] tracking-tight [font-stretch:82%] md:text-5xl">Alat koji zna reći „ne” je alat kojem se vjeruje.</p>
        <p class="mt-10 max-w-md text-[#ECEAE3]/60"><span class="font-mono text-xs uppercase tracking-[0.18em] text-[#ECEAE3]/40">Upanišad</span> — na sanskrtu otprilike „sjesti blizu”. Doći dovoljno blizu da vidiš ono što se izdaleka ne vidi.</p>
        <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.18em] text-[#ECEAE3]/40">Aljmaš, ušće Drave u Dunav · od 2024.</p>
      </div>
      <div class="space-y-6">
        {people.map((p, i) => (
          <div class="grid grid-cols-[120px_1fr] items-start gap-6 md:grid-cols-[160px_1fr]">
            <div class="relative grid aspect-[4/5] place-items-center">
              <div class="ik-corners absolute inset-0 text-[#ECEAE3]/70 [--cl:12px]"></div>
              <span class="font-mono text-[10px] tracking-[0.2em] text-[#ECEAE3]/30">KADAR 0{i + 5}</span>
            </div>
            <div>
              <p class="text-3xl font-[720] tracking-tight [font-stretch:85%]">{p.name}</p>
              <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.18em] text-[#F2A900]">{p.role}</p>
              <p class="mt-3 leading-relaxed text-[#ECEAE3]/70">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="ik-contact" class="scroll-mt-16 border-t border-[#ECEAE3]/10">
    <div class="mx-auto max-w-[1440px] px-6 py-28 md:px-12">
      <h2 class="text-[clamp(3rem,10vw,9rem)] font-[780] leading-[0.85] tracking-[-0.03em] [font-stretch:75%]">Uđite u kadar.</h2>
      <div class="mt-14 grid gap-4 md:grid-cols-2">
        <a data-r={contact.emailReversed} href="#" class="ik-slot group relative block px-6 py-6">
          <span class="ik-corners absolute inset-0 text-[#ECEAE3]/40 transition group-hover:text-[#ECEAE3] [--cl:14px]"></span>
          <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#ECEAE3]/40">e-pošta</span>
          <span data-slot class="ik-est mt-2 block text-2xl font-semibold [--dp:3px] [--dr:1px] md:text-3xl">kliknite za kadar</span>
        </a>
        <a data-r={contact.phoneReversed} data-kind="tel" href="#" class="ik-slot group relative block px-6 py-6">
          <span class="ik-corners absolute inset-0 text-[#ECEAE3]/40 transition group-hover:text-[#ECEAE3] [--cl:14px]"></span>
          <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#ECEAE3]/40">telefon</span>
          <span data-slot class="ik-est mt-2 block text-2xl font-semibold [--dp:3px] [--dr:1px] md:text-3xl">kliknite za kadar</span>
        </a>
      </div>
    </div>
  </section>

  <footer class="border-t border-[#ECEAE3]/10">
    <div class="mx-auto grid max-w-[1440px] gap-6 px-6 py-10 font-mono text-[11px] leading-relaxed text-[#ECEAE3]/40 md:grid-cols-3 md:px-12">
      <div><span class="text-[#ECEAE3]/80">{legal.name}</span><br />{legal.address}</div>
      <div>{legal.court}, MBS {legal.mbs} · OIB {legal.oib}<br />{legal.capital} · {legal.director}</div>
      <div class="md:text-right">{legal.bank}<br /><a href="#" class="hover:text-[#ECEAE3]">Režija (za tim) →</a></div>
    </div>
  </footer>
</div>

<style is:global>
  .ik-solid { color: #ECEAE3; }
  .ik-est {
    color: #F2A900;
    -webkit-mask: radial-gradient(circle, #000 var(--dr, 1.1px), transparent calc(var(--dr, 1.1px) + 0.5px)) 0 0 / var(--dp, 4px) var(--dp, 4px) repeat;
    mask: radial-gradient(circle, #000 var(--dr, 1.1px), transparent calc(var(--dr, 1.1px) + 0.5px)) 0 0 / var(--dp, 4px) var(--dp, 4px) repeat;
  }
  .ik-est-grey { color: #8a8a84; }
  .ik-corners {
    --cl: 16px; --cw: 1.5px;
    background:
      linear-gradient(currentColor, currentColor) top left / var(--cl) var(--cw) no-repeat,
      linear-gradient(currentColor, currentColor) top left / var(--cw) var(--cl) no-repeat,
      linear-gradient(currentColor, currentColor) top right / var(--cl) var(--cw) no-repeat,
      linear-gradient(currentColor, currentColor) top right / var(--cw) var(--cl) no-repeat,
      linear-gradient(currentColor, currentColor) bottom left / var(--cl) var(--cw) no-repeat,
      linear-gradient(currentColor, currentColor) bottom left / var(--cw) var(--cl) no-repeat,
      linear-gradient(currentColor, currentColor) bottom right / var(--cl) var(--cw) no-repeat,
      linear-gradient(currentColor, currentColor) bottom right / var(--cw) var(--cl) no-repeat;
  }
  .ik-cta-solid { background: #ECEAE3; color: #0A0A0B; transition: background 180ms; }
  .ik-cta-solid:hover { background: #9BE564; }
  .ik-cta-est { color: #F2A900; outline: 1.5px dashed #F2A900; outline-offset: -1.5px; transition: all 180ms; }
  .ik-cta-est:hover { color: #0A0A0B; background: #ECEAE3; outline-color: #ECEAE3; outline-style: solid; }
  .ik-src { transition: transform 900ms cubic-bezier(.2,.7,.2,1), opacity 900ms; }
  .ik-match.ik-in .ik-src { transform: translateX(42%); opacity: 0; }
  .ik-rec { opacity: 0; transform: scale(0.96); transition: opacity 500ms 700ms, transform 500ms 700ms; }
  .ik-match.ik-in .ik-rec { opacity: 1; transform: none; }
  #ik-chat[data-state='confirmed'] [data-proposal] { opacity: 0; }
  #ik-chat[data-state='confirmed'] [data-committed] { opacity: 1; }
  #ik-chat[data-state='rejected'] [data-proposal] { text-decoration: line-through; opacity: 0.5; }
  .ik-slot[data-revealed] [data-slot] { -webkit-mask: none; mask: none; color: #ECEAE3; animation: ik-snap 260ms ease-out; }
  .ik-slot[data-revealed] .ik-corners { color: #9BE564; }
  @keyframes ik-snap { from { letter-spacing: 0.2em; opacity: 0.2; } to { letter-spacing: normal; opacity: 1; } }
  .ik-range { accent-color: #F2A900; }
  @media (prefers-reduced-motion: reduce) {
    .ik-src, .ik-rec { transition: none; }
  }
</style>

<script>
  const hero = document.getElementById('ik-hero')!;
  const canvas = document.getElementById('ik-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const frameEl = document.getElementById('ik-frame')!;
  const tcEl = document.getElementById('ik-tc')!;
  const covEl = document.getElementById('ik-cov')!;
  const estEl = document.getElementById('ik-estc')!;
  const framed = [...hero.querySelectorAll<HTMLElement>('[data-framed]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const W = 105, H = 68;
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  type V = [number, number];
  type Player = {
    bx: number; by: number; team: number; ax: number; ay: number; fx: number; fy: number; px: number; py: number;
    pos: V; prev: V; seen: boolean; lp: V; lv: V; tOut: number; trail: V[]; fixAt: number; fixFrom: V; label: boolean;
  };
  const formation = [[6, 34], [20, 12], [18, 27], [18, 41], [20, 56], [36, 20], [34, 34], [36, 48], [50, 12], [52, 34], [50, 56]];
  const players: Player[] = [
    ...formation.map(([x, y]) => ({ x, y, team: 0 })),
    ...formation.map(([x, y]) => ({ x: W - x, y: H - y, team: 1 })),
  ].map(({ x, y, team }, i) => ({
    bx: x, by: y, team, ax: rnd(3, 8), ay: rnd(3, 7), fx: rnd(0.15, 0.32), fy: rnd(0.12, 0.28), px: rnd(0, 6.28), py: rnd(0, 6.28),
    pos: [x, y], prev: [x, y], seen: false, lp: [x, y], lv: [0, 0], tOut: 2, trail: [], fixAt: -1e9, fixFrom: [x, y],
    label: [2, 13, 18].includes(i),
  }));
  const truePos = (p: Player, t: number): V => {
    const shift = 9 * Math.sin(t * 0.09);
    return [
      p.bx + shift + p.ax * Math.sin(t * p.fx + p.px) + 1.8 * Math.sin(t * p.fx * 2.7 + p.py),
      p.by + p.ay * Math.cos(t * p.fy + p.py) + 1.8 * Math.sin(t * p.fy * 3.1 + p.px),
    ];
  };
  const estimate = (p: Player): V => {
    const k = 1.1 * (1 - Math.exp(-p.tOut / 1.1));
    return [p.lp[0] + p.lv[0] * k, p.lp[1] + p.lv[1] * k];
  };
  const uncertainty = (p: Player) => Math.min(0.6 + 1.3 * p.tOut, 7);

  let cw = 0, ch = 0, dpr = 1, s = 1, ox = 0, oy = 0, fw = 0, fh = 0;
  function layout() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    cw = hero.clientWidth; ch = hero.clientHeight;
    if (canvas.width !== Math.round(cw * dpr) || canvas.height !== Math.round(ch * dpr)) {
      canvas.width = Math.round(cw * dpr); canvas.height = Math.round(ch * dpr);
    }
    s = Math.min((cw * 0.96) / W, (ch * 0.84) / H);
    ox = (cw - W * s) / 2; oy = (ch - H * s) / 2 + 10;
    fw = Math.min(cw * (cw > 768 ? 0.42 : 0.72), 660); fh = (fw * 9) / 16;
    frameEl.style.width = `${fw}px`; frameEl.style.height = `${fh}px`;
  }
  const X = (x: number) => ox + x * s;
  const Y = (y: number) => oy + y * s;

  const cam = { x: 0, y: 0 };
  let target = { x: 0, y: 0 }, manualUntil = 0;
  const ball: { x: number; y: number } = { x: W / 2, y: H / 2 };
  let holder = 9, nextPass = 0;
  let frame = { l: 0, t: 0, r: 0, b: 0 };

  hero.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    const r = hero.getBoundingClientRect();
    target = { x: e.clientX - r.left, y: e.clientY - r.top };
    manualUntil = performance.now() + 2500;
    if (reduce) { cam.x = target.x; cam.y = target.y; render(lastT, 0); }
  });

  function pitch(alpha: number) {
    ctx.strokeStyle = `rgba(236,234,227,${alpha})`;
    ctx.lineWidth = 1.2;
    ctx.strokeRect(X(0), Y(0), W * s, H * s);
    ctx.beginPath(); ctx.moveTo(X(W / 2), Y(0)); ctx.lineTo(X(W / 2), Y(H)); ctx.stroke();
    ctx.beginPath(); ctx.arc(X(W / 2), Y(H / 2), 9.15 * s, 0, Math.PI * 2); ctx.stroke();
    for (const side of [0, 1]) {
      ctx.strokeRect(X(side ? W - 16.5 : 0), Y(H / 2 - 20.15), 16.5 * s, 40.3 * s);
      ctx.strokeRect(X(side ? W - 5.5 : 0), Y(H / 2 - 9.15), 5.5 * s, 18.3 * s);
    }
  }

  let lastT = 10, lastHud = 0;
  function render(t: number, dt: number) {
    const now = t * 1000;
    // simulate
    for (const p of players) { p.prev = p.pos; p.pos = truePos(p, t); }
    if (now > nextPass) {
      const team = players[holder].team ^ (Math.random() < 0.25 ? 1 : 0);
      const pool = players.map((p, i) => [p, i] as const).filter(([p]) => p.team === team);
      holder = pool[Math.floor(Math.random() * pool.length)][1];
      nextPass = now + rnd(900, 2200);
    }
    const hp = players[holder].pos;
    const kb = dt ? 1 - Math.exp(-dt / 0.35) : 1;
    ball.x += (hp[0] - ball.x) * kb; ball.y += (hp[1] - ball.y) * kb;

    const auto = performance.now() > manualUntil;
    const tgt = auto ? { x: X(ball.x), y: Y(ball.y) } : target;
    const kc = dt ? 1 - Math.exp(-dt / 0.3) : 1;
    cam.x += (tgt.x - cam.x) * kc; cam.y += (tgt.y - cam.y) * kc;
    const cx = clamp(cam.x, fw / 2 + 8, cw - fw / 2 - 8), cy = clamp(cam.y, fh / 2 + 70, ch - fh / 2 - 48);
    frame = { l: cx - fw / 2, t: cy - fh / 2, r: cx + fw / 2, b: cy + fh / 2 };

    for (const p of players) {
      const sx = X(p.pos[0]), sy = Y(p.pos[1]);
      const inside = sx >= frame.l && sx <= frame.r && sy >= frame.t && sy <= frame.b;
      if (inside) {
        if (!p.seen) { p.fixAt = now; p.fixFrom = estimate(p); p.trail = []; }
        p.seen = true;
        if (dt) {
          const v: V = [(p.pos[0] - p.prev[0]) / dt, (p.pos[1] - p.prev[1]) / dt];
          p.lv = [p.lv[0] * 0.85 + v[0] * 0.15, p.lv[1] * 0.85 + v[1] * 0.15];
        }
        p.lp = p.pos; p.tOut = 0;
        p.trail.push(p.pos); if (p.trail.length > 40) p.trail.shift();
      } else {
        p.seen = false; p.tOut += dt;
      }
    }

    // draw
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, cw, ch);
    pitch(0.07);
    ctx.save();
    ctx.beginPath(); ctx.rect(frame.l, frame.t, fw, fh); ctx.clip();
    ctx.fillStyle = 'rgba(236,234,227,0.035)'; ctx.fillRect(frame.l, frame.t, fw, fh);
    pitch(0.28);
    ctx.restore();

    ctx.font = '11px "JetBrains Mono Variable", monospace';
    for (const p of players) {
      if (p.seen) {
        for (let i = 1; i < p.trail.length; i++) {
          ctx.strokeStyle = `rgba(236,234,227,${(i / p.trail.length) * 0.55})`;
          ctx.lineWidth = 2;
          ctx.beginPath(); ctx.moveTo(X(p.trail[i - 1][0]), Y(p.trail[i - 1][1])); ctx.lineTo(X(p.trail[i][0]), Y(p.trail[i][1])); ctx.stroke();
        }
        const age = (now - p.fixAt) / 700;
        if (age < 1) {
          ctx.strokeStyle = `rgba(242,169,0,${1 - age})`;
          ctx.lineWidth = 1.5; ctx.setLineDash([3, 3]);
          ctx.beginPath(); ctx.moveTo(X(p.fixFrom[0]), Y(p.fixFrom[1])); ctx.lineTo(X(p.pos[0]), Y(p.pos[1])); ctx.stroke();
          ctx.setLineDash([]);
        }
        ctx.fillStyle = p.team ? '#9a9a93' : '#ECEAE3';
        ctx.beginPath(); ctx.arc(X(p.pos[0]), Y(p.pos[1]), 5.5, 0, Math.PI * 2); ctx.fill();
      } else {
        const e = estimate(p), u = uncertainty(p);
        ctx.strokeStyle = 'rgba(242,169,0,0.75)';
        ctx.lineWidth = 1.2; ctx.setLineDash([2, 4]);
        ctx.beginPath(); ctx.arc(X(e[0]), Y(e[1]), Math.max(6, u * s), 0, Math.PI * 2); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = 'rgba(242,169,0,0.9)';
        ctx.beginPath(); ctx.arc(X(e[0]), Y(e[1]), 2.2, 0, Math.PI * 2); ctx.fill();
        if (p.label) ctx.fillText(`±${u.toFixed(1).replace('.', ',')} m`, X(e[0]) + Math.max(6, u * s) + 6, Y(e[1]) + 4);
      }
    }
    if (ball.x && X(ball.x) > frame.l && X(ball.x) < frame.r && Y(ball.y) > frame.t && Y(ball.y) < frame.b) {
      ctx.fillStyle = '#9BE564';
      ctx.beginPath(); ctx.arc(X(ball.x) + 6, Y(ball.y) - 6, 3.2, 0, Math.PI * 2); ctx.fill();
    }

    // frame + clipped solid text (read all rects first, then write)
    const hr = hero.getBoundingClientRect();
    const rects = framed.map((el) => el.getBoundingClientRect());
    frameEl.style.transform = `translate(${frame.l}px, ${frame.t}px)`;
    framed.forEach((el, i) => {
      const r = rects[i];
      const top = frame.t + hr.top - r.top, left = frame.l + hr.left - r.left;
      const bottom = r.bottom - (frame.b + hr.top), right = r.right - (frame.r + hr.left);
      el.style.clipPath = `inset(${top}px ${right}px ${bottom}px ${left}px)`;
    });

    if (now - lastHud > 200 || !dt) {
      lastHud = now;
      const pl = X(0), pt = Y(0), pr = X(W), pb = Y(H);
      const iw = Math.max(0, Math.min(frame.r, pr) - Math.max(frame.l, pl));
      const ih = Math.max(0, Math.min(frame.b, pb) - Math.max(frame.t, pt));
      covEl.textContent = String(Math.round(((iw * ih) / ((pr - pl) * (pb - pt))) * 100));
      estEl.textContent = String(players.filter((p) => !p.seen).length);
      const f = Math.floor(t * 25) + 23 * 60 * 25 * 60 / 60 + 41 * 60 * 25;
      const ff = f % 25, ss = Math.floor(f / 25) % 60, mm = Math.floor(f / 1500) % 60, hh = Math.floor(f / 90000);
      tcEl.textContent = [hh, mm, ss, ff].map((n) => String(n).padStart(2, '0')).join(':');
    }
  }

  layout();
  cam.x = cw / 2; cam.y = ch / 2;
  window.addEventListener('resize', () => { layout(); if (reduce) render(lastT, 0); });
  window.addEventListener('variantchange', () => { layout(); render(lastT, 0); });

  if (reduce) {
    render(lastT, 0);
  } else {
    let prev = performance.now();
    const loop = (nowMs: number) => {
      requestAnimationFrame(loop);
      const dt = Math.min((nowMs - prev) / 1000, 0.05); prev = nowMs;
      if (hero.offsetParent === null) return;
      const r = hero.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      if (cw !== hero.clientWidth || ch !== hero.clientHeight) layout();
      lastT = nowMs / 1000;
      render(lastT, dt);
    };
    requestAnimationFrame(loop);
  }

  // "Mnogo izvora, jedan zapis" — run the merge once it scrolls into view.
  const io = new IntersectionObserver((entries) => entries.forEach((en) => {
    if (en.isIntersecting) { en.target.classList.add('ik-in'); io.unobserve(en.target); }
  }), { threshold: 0.5 });
  document.querySelectorAll('.ik [data-inview]').forEach((el) => io.observe(el));

  // Agent proposal: confirm / reject.
  const chat = document.getElementById('ik-chat')!;
  const stamp = chat.querySelector<HTMLElement>('[data-stamp]')!;
  chat.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) => b.addEventListener('click', () => {
    const confirm = b.dataset.act === 'confirm';
    chat.dataset.state = confirm ? 'confirmed' : 'rejected';
    chat.querySelector<HTMLElement>('[data-buttons]')!.hidden = true;
    stamp.classList.remove('hidden');
    stamp.style.color = confirm ? '#9BE564' : '#ECEAE3';
    const ts = new Date().toTimeString().slice(0, 8);
    stamp.textContent = confirm
      ? `potvrđeno ${ts} · poslužitelj: provedeno = predloženo ✓ · Booking.com ažuriran`
      : `odbačeno ${ts} · ništa nije promijenjeno.`;
  }));

  // OTISAK horizon slider.
  const pred = document.getElementById('ik-pred') as unknown as SVGPathElement;
  const base = document.getElementById('ik-base')!, goal = document.getElementById('ik-goal')!, pt = document.getElementById('ik-pt')!;
  const hIn = document.getElementById('ik-h') as HTMLInputElement;
  const hv = document.getElementById('ik-hv')!, bv = document.getElementById('ik-bv')!, gv = document.getElementById('ik-gv')!;
  const len = pred.getTotalLength();
  function horizon() {
    const h = Number(hIn.value);
    const p = pred.getPointAtLength((len * h) / 4);
    const bm = 1.2 * h, gm = bm * 0.9, px = 14;
    base.setAttribute('cx', String(p.x)); base.setAttribute('cy', String(p.y));
    base.setAttribute('rx', String(bm * px * 1.3)); base.setAttribute('ry', String(bm * px));
    goal.setAttribute('cx', String(p.x)); goal.setAttribute('cy', String(p.y));
    goal.setAttribute('rx', String(gm * px * 1.3)); goal.setAttribute('ry', String(gm * px));
    pt.setAttribute('cx', String(p.x)); pt.setAttribute('cy', String(p.y));
    const fmt = (n: number) => n.toFixed(1).replace('.', ',');
    hv.textContent = fmt(h); bv.textContent = fmt(bm); gv.textContent = fmt(gm);
  }
  hIn.addEventListener('input', horizon);
  horizon();
</script>
