---
// PROTOTYPE — Concept "Ušće" (from Fable). Aljmaš sits where the Drava meets the Danube; the core product is a
// confluence too — many provider streams merging into one feed. Hero = a labelled river network that bends
// away from the cursor; hover a source to trace it to the feed. A "spine" carries the river down the page.
import { work, people, contact, legal } from './content';
---

<div class="us min-h-screen bg-[#F3EFE6] font-sans text-[#1B2A33] selection:bg-[#E8C547]">
  <header class="absolute inset-x-0 top-0 z-30">
    <div class="mx-auto flex max-w-[1440px] items-baseline justify-between px-6 py-6 md:px-10">
      <a href="#" class="font-iserif text-3xl leading-none">Upanishad</a>
      <nav class="hidden gap-7 text-sm text-[#1B2A33]/70 md:flex">
        <a href="#us-what" class="hover:text-[#2C5A6E]">Što radimo</a><a href="#us-work" class="hover:text-[#2C5A6E]">Radovi</a>
        <a href="#us-rnd" class="hover:text-[#2C5A6E]">Istraživanje</a><a href="#us-about" class="hover:text-[#2C5A6E]">O nama</a>
      </nav>
      <span class="font-mono text-xs text-[#1B2A33]/50"><b class="text-[#1B2A33]">HR</b> EN</span>
    </div>
  </header>

  <section id="us-hero" class="relative h-[100svh] min-h-[680px] overflow-hidden">
    <canvas id="us-canvas" class="absolute inset-0 size-full"></canvas>
    <div class="pointer-events-none relative z-10 mx-auto flex h-full max-w-[1440px] flex-col justify-end px-6 pb-16 md:px-10">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#2C5A6E]">Softver za sportsku industriju</p>
      <h1 class="mt-4 font-iserif text-[clamp(3.6rem,10vw,10.5rem)] leading-[0.86] tracking-[-0.02em]">Mnogo izvora.<br /><em class="text-[#2C5A6E]">Jedan feed.</em></h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#1B2A33]/75">Desetci pružatelja, isti susreti pod različitim imenima. Uparujemo ih, određujemo cijenu za svakog klijenta i isporučujemo jedan standardni feed — prosječno za 0,4 ms.</p>
      <p id="us-trace" class="mt-6 min-h-5 font-mono text-[12px] text-[#1B2A33]/60">prijeđite mišem preko izvora lijevo</p>
    </div>
  </section>

  <div class="relative">
    <div class="pointer-events-none absolute bottom-0 left-6 top-0 w-[10px] md:left-[70px]">
      <div class="mx-auto h-full w-[10px] rounded-full bg-[#2C5A6E]"></div>
    </div>

    <section id="us-what" class="relative mx-auto max-w-[1440px] scroll-mt-6 py-28 pl-16 pr-6 md:pl-[180px] md:pr-10">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#2C5A6E]">Agenti</p>
      <div class="mt-6 grid gap-12 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <h2 class="font-iserif text-5xl leading-[0.95] md:text-7xl">Tri kanala, <em>jedna brana.</em></h2>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-[#1B2A33]/75">AI agent predlaže, čovjek potvrđuje, poslužitelj provodi. Ništa ne prolazi branu bez potvrde. Tako Aura vodi kuću za odmor: cijene, dostupnost, poruke gostima, eVisitor i računi — razgovorom na hrvatskom.</p>
        </div>
        <svg viewBox="0 0 560 260" class="w-full" aria-hidden="true">
          <g fill="none" stroke-linecap="round">
            <path d="M0 130 C 60 130, 80 60, 160 60 L 360 60 C 420 60, 440 130, 560 130" stroke="#2C5A6E" stroke-width="3" />
            <path d="M0 130 L 560 130" stroke="#C9A66B" stroke-width="3" />
            <path d="M0 130 C 60 130, 80 200, 160 200 L 360 200 C 420 200, 440 130, 560 130" stroke="#5B6B74" stroke-width="3" />
            <path class="us-flow" d="M0 130 C 60 130, 80 60, 160 60 L 360 60 C 420 60, 440 130, 560 130" stroke="#F3EFE6" stroke-width="1.5" stroke-dasharray="2 14" />
            <path class="us-flow" d="M0 130 L 560 130" stroke="#F3EFE6" stroke-width="1.5" stroke-dasharray="2 14" />
            <path class="us-flow" d="M0 130 C 60 130, 80 200, 160 200 L 360 200 C 420 200, 440 130, 560 130" stroke="#F3EFE6" stroke-width="1.5" stroke-dasharray="2 14" />
          </g>
          <rect x="300" y="36" width="8" height="188" fill="#1B2A33" />
          <text x="314" y="30" font-size="11" font-family="JetBrains Mono Variable" fill="#1B2A33">BRANA: POTVRDA</text>
          <g font-size="11" font-family="JetBrains Mono Variable" fill="#1B2A33" fill-opacity="0.7">
            <text x="170" y="50">agent predlaže</text><text x="170" y="122">čovjek potvrđuje</text><text x="170" y="192">poslužitelj provjerava</text>
          </g>
        </svg>
      </div>
    </section>

    <section id="us-rnd" class="relative mx-auto max-w-[1440px] scroll-mt-6 py-28 pl-16 pr-6 md:pl-[180px] md:pr-10">
      <svg class="absolute left-6 top-28 h-[340px] w-[260px] md:left-[70px]" viewBox="0 0 260 340" aria-hidden="true">
        <path d="M5 0 C 5 80, 40 120, 120 150 S 240 220, 250 340" fill="none" stroke="#2C5A6E" stroke-width="6" stroke-dasharray="1 10" stroke-linecap="round" />
        <path d="M5 0 C 5 120, 20 180, 60 240 S 120 320, 130 340" fill="none" stroke="#C9A66B" stroke-width="6" stroke-dasharray="1 10" stroke-linecap="round" />
      </svg>
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#2C5A6E]">Istraživanje</p>
      <h2 class="mt-6 max-w-4xl font-iserif text-5xl leading-[0.95] md:text-7xl">Do sada smo gradili za druge. <em class="text-[#2C5A6E]">Ovdje se rađa vlastiti tok.</em></h2>
      <div class="mt-16 grid gap-10 md:ml-[200px] md:grid-cols-2">
        <article class="border-l-2 border-dashed border-[#2C5A6E] pl-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#2C5A6E]">OTISAK · dokazivanje koncepta</p>
          <h3 class="mt-3 font-iserif text-4xl">Digitalni otisak kretanja igrača</h3>
          <p class="mt-3 leading-relaxed text-[#1B2A33]/75">TV snimka ne prikazuje igrače bez lopte — 40–64 % položaja je procjena. Učimo „otisak” kretanja svakog igrača da bismo predvidjeli položaje 1–4 s unaprijed.</p>
        </article>
        <article class="border-l-2 border-dashed border-[#C9A66B] pl-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#8a6d35]">KLIMA · u pripremi</p>
          <h3 class="mt-3 font-iserif text-4xl">Prediktivno upravljanje toplinom</h3>
          <p class="mt-3 leading-relaxed text-[#1B2A33]/75">Vodeni krug s više spremnika topline, vođen vremenskom prognozom. Prvi prototip je staklenik.</p>
        </article>
      </div>
    </section>

    <section id="us-work" class="relative mx-auto max-w-[1440px] scroll-mt-6 py-28 pl-16 pr-6 md:pl-[180px] md:pr-10">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#2C5A6E]">Radovi · ušća</p>
      {work.map((w, i) => (
        <article class="relative grid gap-6 border-b border-[#1B2A33]/15 py-12 md:grid-cols-[1fr_1.3fr]">
          <span class="absolute -left-[110px] top-14 hidden size-5 rounded-full border-[5px] border-[#2C5A6E] bg-[#F3EFE6] md:block"></span>
          <div>
            <p class="font-mono text-[11px] text-[#1B2A33]/50">ušće 0{i + 1} · {w.status.toLowerCase()}</p>
            <h3 class="mt-2 font-iserif text-5xl md:text-6xl">{w.client}</h3>
            <p class="mt-1 italic text-[#2C5A6E]">{w.kind}</p>
          </div>
          <div>
            <p class="text-lg leading-relaxed text-[#1B2A33]/75">{w.body}</p>
            <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.12em] text-[#1B2A33]/50">{w.role}</p>
          </div>
        </article>
      ))}
    </section>

    <section id="us-about" class="relative mx-auto grid max-w-[1440px] scroll-mt-6 gap-12 py-28 pl-16 pr-6 md:pl-[180px] md:pr-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#2C5A6E]">O nama</p>
        <h2 class="mt-6 font-iserif text-5xl leading-[0.95] md:text-7xl">Iz Aljmaša, <em>gdje Drava ulazi u Dunav.</em></h2>
        <div class="mt-12 space-y-8">
          {people.map((p) => (
            <div><h3 class="font-iserif text-4xl">{p.name}</h3><p class="font-mono text-[11px] uppercase tracking-[0.16em] text-[#2C5A6E]">{p.role}</p><p class="mt-2 text-[#1B2A33]/75">{p.body}</p></div>
          ))}
        </div>
        <p class="mt-12 max-w-md text-sm text-[#1B2A33]/60"><em class="font-iserif text-lg">Upanishad</em> — sanskrt, otprilike „sjesti blizu”.</p>
      </div>
      <figure>
        <svg viewBox="0 0 520 520" class="w-full" role="img" aria-label="Shematska karta ušća Drave u Dunav kod Aljmaša">
          <g fill="none" stroke="#C9A66B" stroke-opacity="0.55">
            {[0, 1, 2, 3, 4, 5, 6].map((k) => <path d={`M${-20 + k * 10} ${60 + k * 22} C ${140 + k * 6} ${100 + k * 18}, ${200 - k * 4} ${260 + k * 8}, ${330 - k * 6} ${300 + k * 14} S ${460 - k * 8} ${440 - k * 6}, ${540} ${420 + k * 12}`} />)}
          </g>
          <path d="M260 -10 C 250 80, 300 150, 290 230 S 250 380, 300 530" fill="none" stroke="#2C5A6E" stroke-width="22" stroke-linecap="round" />
          <path d="M-10 250 C 80 240, 160 280, 210 270 S 270 250, 288 262" fill="none" stroke="#2C5A6E" stroke-width="11" stroke-linecap="round" />
          <circle cx="318" cy="292" r="7" fill="#1B2A33" />
          <text x="332" y="297" font-size="14" font-family="Instrument Serif" font-style="italic" fill="#1B2A33">Aljmaš</text>
          <text x="40" y="236" font-size="11" font-family="JetBrains Mono Variable" fill="#2C5A6E" letter-spacing="2">DRAVA</text>
          <text x="226" y="40" font-size="11" font-family="JetBrains Mono Variable" fill="#2C5A6E" letter-spacing="2" transform="rotate(-80 226 40)">DUNAV</text>
        </svg>
        <figcaption class="mt-2 font-mono text-[10px] uppercase tracking-[0.16em] text-[#1B2A33]/45">shematski prikaz · nije u mjerilu</figcaption>
      </figure>
    </section>

    <section id="us-contact" class="relative mx-auto max-w-[1440px] py-28 pl-16 pr-6 md:pl-[180px] md:pr-10">
      <h2 class="font-iserif text-[clamp(3.4rem,9vw,8rem)] leading-[0.9]">Pridružite se <em class="text-[#2C5A6E]">toku.</em></h2>
      <div class="mt-10 flex flex-col gap-4 text-xl md:flex-row md:gap-12">
        <a data-r={contact.emailReversed} href="#" class="border-b-2 border-[#E8C547] pb-1 hover:text-[#2C5A6E]"><span data-slot>prikaži e-poštu</span></a>
        <a data-r={contact.phoneReversed} data-kind="tel" href="#" class="border-b-2 border-[#E8C547] pb-1 hover:text-[#2C5A6E]"><span data-slot>prikaži telefon</span></a>
      </div>
    </section>
  </div>

  <footer class="bg-[#1B2A33] text-[#F3EFE6]/60">
    <div class="mx-auto grid max-w-[1440px] gap-6 px-6 py-10 font-mono text-[11px] leading-relaxed md:grid-cols-3 md:px-10">
      <div><b class="text-[#F3EFE6]">{legal.name}</b><br />{legal.address}</div>
      <div>{legal.court}, MBS {legal.mbs} · OIB {legal.oib}<br />{legal.capital} · {legal.director}</div>
      <div class="md:text-right">{legal.bank}<br /><a href="#" class="hover:text-[#E8C547]">Pritoke (za tim) →</a></div>
    </div>
  </footer>
</div>

<style is:global>
  .us-flow { animation: us-flow 2.2s linear infinite; }
  @keyframes us-flow { to { stroke-dashoffset: -32; } }
  @media (prefers-reduced-motion: reduce) { .us-flow { animation: none; } }
</style>

<script>
  const hero = document.getElementById('us-hero')!;
  const canvas = document.getElementById('us-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const traceEl = document.getElementById('us-trace')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Pt = { x: number; y: number };
  type Node = { x: number; y: number; level: number; leaves: number; parent?: Node; label?: string; seed: number };

  const LEAVES = 32;
  let nodes: Node[] = [], edges: [Node, Node][] = [], leaves: Node[] = [], root!: Node;
  let w = 0, h = 0, dpr = 1;
  const mouse = { x: -9999, y: -9999 };
  let hot: Node | null = null;

  function build() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    w = hero.clientWidth; h = hero.clientHeight;
    canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
    nodes = []; edges = [];
    const top = h * 0.1, bottom = h * 0.62, cx = w * 0.78, cy = h * 0.36;
    let level: Node[] = Array.from({ length: LEAVES }, (_, i) => ({
      x: w * 0.02, y: top + ((bottom - top) * (i + 0.5)) / LEAVES, level: 0, leaves: 1,
      label: `src-${String(((i * 7) % LEAVES) + 1).padStart(2, '0')}`, seed: Math.random() * 10,
    }));
    leaves = level; nodes.push(...level);
    let L = 0;
    while (level.length > 1) {
      L++;
      const next: Node[] = [];
      for (let i = 0; i < level.length; i += 2) {
        const a = level[i], b = level[i + 1] ?? level[i];
        const t = L / Math.log2(LEAVES);
        const n: Node = { x: w * 0.02 + (cx - w * 0.02) * t, y: ((a.y + b.y) / 2) * (1 - t * 0.55) + cy * t * 0.55, level: L, leaves: a.leaves + (b === a ? 0 : b.leaves), seed: Math.random() * 10 };
        a.parent = n; edges.push([a, n]);
        if (b !== a) { b.parent = n; edges.push([b, n]); }
        next.push(n); nodes.push(n);
      }
      level = next;
    }
    root = level[0];
  }

  const bez = (a: Pt, b: Pt, t: number): Pt => {
    const mx = (a.x + b.x) / 2, u = 1 - t;
    return { x: u * u * u * a.x + 3 * u * u * t * mx + 3 * u * t * t * mx + t * t * t * b.x, y: u * u * u * a.y + 3 * u * u * t * a.y + 3 * u * t * t * b.y + t * t * t * b.y };
  };
  const displace = (p: Pt, time: number, seed: number): Pt => {
    let x = p.x, y = p.y + Math.sin(time * 0.6 + seed + p.x * 0.01) * 2.5;
    const dx = x - mouse.x, dy = y - mouse.y, d = Math.hypot(dx, dy), R = 140;
    if (d < R && d > 0.01) { const f = ((R - d) / R) ** 2 * 38; x += (dx / d) * f; y += (dy / d) * f; }
    return { x, y };
  };
  const onPath = (n: Node) => { for (let m: Node | undefined = hot ?? undefined; m; m = m.parent) if (m === n) return true; return false; };

  function draw(time: number) {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    ctx.lineCap = 'round';
    for (const [a, b] of edges) {
      const lit = hot && onPath(a);
      ctx.strokeStyle = lit ? '#E8C547' : a.level === 0 ? 'rgba(27,42,51,0.45)' : '#2C5A6E';
      ctx.lineWidth = lit ? Math.max(3, 1.2 + Math.sqrt(a.leaves) * 2.2) : 0.9 + Math.sqrt(a.leaves) * 1.9;
      ctx.beginPath();
      for (let k = 0; k <= 22; k++) {
        const p = displace(bez(a, b, k / 22), time, a.seed);
        k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
      }
      ctx.stroke();
    }
    // outflow: the single feed to the right edge
    const r0 = displace(root, time, root.seed);
    ctx.strokeStyle = hot ? '#E8C547' : '#2C5A6E';
    ctx.lineWidth = 1.2 + Math.sqrt(LEAVES) * 2.2;
    ctx.beginPath(); ctx.moveTo(r0.x, r0.y); ctx.lineTo(w + 20, r0.y); ctx.stroke();
    // moving particles = messages
    ctx.fillStyle = '#F3EFE6';
    for (const [a, b] of edges) {
      const t = ((time * 0.35 + a.seed) % 1);
      const p = displace(bez(a, b, t), time, a.seed);
      ctx.beginPath(); ctx.arc(p.x, p.y, a.level === 0 ? 1.2 : 1.8, 0, Math.PI * 2); ctx.fill();
    }
    ctx.font = '10px "JetBrains Mono Variable", monospace';
    for (const l of leaves) {
      ctx.fillStyle = hot === l ? '#1B2A33' : 'rgba(27,42,51,0.45)';
      const p = displace(l, time, l.seed);
      ctx.fillText(l.label!, p.x + 4, p.y - 4);
    }
    ctx.fillStyle = '#1B2A33';
    ctx.font = '11px "JetBrains Mono Variable", monospace';
    ctx.fillText('STANDARDNI FEED →', Math.min(w - 150, r0.x + 30), r0.y - 22);
    ctx.fillStyle = 'rgba(27,42,51,0.6)';
    ctx.fillText('uparivanje · cijena po klijentu · 0,4 ms', Math.min(w - 280, r0.x + 30), r0.y + 34);
  }

  hero.addEventListener('pointermove', (e) => {
    const r = hero.getBoundingClientRect();
    mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    let best: Node | null = null, bd = 18;
    if (mouse.x < w * 0.3) for (const l of leaves) { const d = Math.abs(l.y - mouse.y); if (d < bd) { bd = d; best = l; } }
    if (best !== hot) {
      hot = best;
      traceEl.textContent = hot ? `${hot.label} → normalizacija → uparivanje → ID 48121 → cijena po klijentu → standardni feed` : 'prijeđite mišem preko izvora lijevo';
    }
    if (reduce) draw(0);
  });
  hero.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; hot = null; if (reduce) draw(0); });

  build();
  addEventListener('resize', () => { build(); if (reduce) draw(0); });
  addEventListener('variantchange', () => { build(); draw(performance.now() / 1000); });
  if (reduce) draw(0);
  else {
    const loop = (ms: number) => {
      requestAnimationFrame(loop);
      if (hero.offsetParent === null) return;
      const r = hero.getBoundingClientRect();
      if (r.bottom < 0) return;
      if (w !== hero.clientWidth || h !== hero.clientHeight) build();
      draw(ms / 1000);
    };
    requestAnimationFrame(loop);
  }
</script>
