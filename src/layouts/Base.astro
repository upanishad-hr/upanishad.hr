---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'hr' | 'en';
  noindex?: boolean;
  // Public URL of this page in each language (hreflang + canonical). Defaults to the homepage.
  urls?: { hr: string; en: string };
}

const {
  title,
  description,
  lang = 'hr',
  noindex = false,
  urls = { hr: 'https://upanishad.hr/', en: 'https://upanishad.hr/en/' },
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" hreflang="hr" href={urls.hr} />
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="x-default" href={urls.hr} />
    <link rel="canonical" href={urls[lang]} />
  </head>
  <body>
    <slot />
  </body>
</html>
