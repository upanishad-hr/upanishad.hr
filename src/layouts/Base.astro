---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'hr' | 'en';
  noindex?: boolean;
}

const { title, description, lang = 'hr', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" hreflang="hr" href="https://upanishad.hr/" />
    <link rel="alternate" hreflang="en" href="https://upanishad.hr/en/" />
    <link rel="alternate" hreflang="x-default" href="https://upanishad.hr/" />
    <link rel="canonical" href={lang === 'en' ? 'https://upanishad.hr/en/' : 'https://upanishad.hr/'} />
  </head>
  <body>
    <slot />
  </body>
</html>
