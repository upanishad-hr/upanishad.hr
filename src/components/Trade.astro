---
// trade.upanishad.hr: Upanishad as a sales agent for Western Balkan manufacturers in Croatia.
// Built under /trade/ (HR) and /trade/en/ (EN); netlify.toml serves them at trade.upanishad.hr/ and /en/.
// Links between the two languages are relative, so they work on both hosts. Text: src/i18n/trade.ts.
// Same palette, fonts, logo and legal footer as the homepage, but static: no canvas, no client JavaScript.
import TradeMap from './TradeMap.astro';
import { legal, trade } from '../data/company';
import { strings, type Lang } from '../i18n/strings';
import { tradeStrings } from '../i18n/trade';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tradeStrings[lang];
const L = strings[lang].legal;
const href = lang === 'hr' ? { hr: './', en: 'en/' } : { hr: '../', en: './' };
const home = trade.home[lang];
const mail = `mailto:${trade.email}`;

const h2 = 'text-[clamp(2.4rem,5.4vw,5rem)] font-[740] leading-[0.92] tracking-tight [font-stretch:80%]';
const em = 'font-iserif font-normal [font-stretch:100%]';
const li = 'relative pl-7 before:absolute before:left-0 before:top-[0.78em] before:h-[2px] before:w-4 before:rounded-full before:bg-[#2C5A6E]';
---

<div class="min-h-screen bg-[#0B0F12] font-archivo text-[#ECEAE3]">
  <header class="absolute inset-x-0 top-0 z-30">
    <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-6 py-6 md:px-12">
      <a href="./" class="flex items-center gap-3 font-iserif text-[26px] leading-none md:text-[28px]">
        <svg viewBox="0 0 32 32" class="size-7 shrink-0" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M2 19 C 9 14, 13 22, 16 16 S 24 12, 30 15" fill="none" stroke="#6FB3CF" stroke-width="2" stroke-linecap="round" /></svg>
        Upanishad
        <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#F2A900]">trade</span>
      </a>
      <nav class="hidden gap-8 text-sm text-[#ECEAE3]/65 lg:flex">
        <a href="#kako" class="hover:text-[#ECEAE3]">{t.nav.how}</a>
        <a href="#proizvodaci" class="hover:text-[#ECEAE3]">{t.nav.makers}</a>
        <a href="#kupci" class="hover:text-[#ECEAE3]">{t.nav.buyers}</a>
        <a href="#kontakt" class="hover:text-[#ECEAE3]">{t.nav.contact}</a>
      </nav>
      <div class="flex items-center gap-5 text-sm">
        <a href={home} class="hidden text-[#ECEAE3]/65 hover:text-[#ECEAE3] md:inline">{t.nav.company} ↗</a>
        <span class="flex gap-2 text-[#ECEAE3]/50">
          <a href={href.hr} lang="hr" hreflang="hr" class:list={['hover:text-[#ECEAE3]', lang === 'hr' && 'font-medium text-[#ECEAE3]']} aria-current={lang === 'hr' ? 'page' : undefined}>HR</a>
          <a href={href.en} lang="en" hreflang="en" class:list={['hover:text-[#ECEAE3]', lang === 'en' && 'font-medium text-[#ECEAE3]']} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
        </span>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative mx-auto grid max-w-[1440px] items-end gap-14 px-6 pb-8 pt-32 md:px-12 md:pb-20 md:pt-40 lg:grid-cols-[1.25fr_1fr] lg:gap-20">
      <div>
        <p class="font-mono text-[11px] tracking-[0.06em] text-[#ECEAE3]/50">{t.hero.place}</p>
        <h1 class="mt-4 text-[clamp(2.7rem,6.4vw,6.6rem)] font-[760] leading-[0.9] tracking-[-0.02em] [font-stretch:78%]">{t.hero.h1} <em class="font-iserif text-[1.06em] font-normal tracking-normal [font-stretch:100%]">{t.hero.h1em}</em></h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-[#ECEAE3]/75 md:text-xl">{t.hero.lead}</p>
        <p class="mt-6 max-w-2xl font-mono text-[11px] leading-relaxed tracking-[0.06em] text-[#ECEAE3]/50">{t.hero.countries}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={mail} class="tr-pill-solid px-5 py-2.5 text-sm">{t.hero.cta}</a>
          <a href="#kako" class="tr-pill-est px-5 py-2.5 text-sm">{t.hero.cta2}</a>
        </div>
      </div>
      <div class="rounded-3xl border border-[#ECEAE3]/12 bg-[#ECEAE3]/[0.03] p-4 md:p-6">
        <TradeMap t={t.map} />
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="kako" class="relative scroll-mt-6 pb-36 pt-16">
      <div class="mx-auto max-w-[1440px] px-6 md:px-12">
        <h2 class={h2}>{t.how.h2} <em class={em}>{t.how.h2em}</em></h2>
        <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {t.how.steps.map((s, i) => (
            <li class="border-t border-[#ECEAE3]/15 pt-5">
              <span class="font-mono text-[12px] text-[#F2A900]">{String(i + 1).padStart(2, '0')}</span>
              <p class="mt-3 text-lg leading-relaxed text-[#ECEAE3]/80">{s}</p>
            </li>
          ))}
        </ol>
        <p class="mt-12 max-w-2xl text-lg leading-relaxed text-[#ECEAE3]">{t.how.note}</p>
      </div>
    </section>

    <!-- FOR MANUFACTURERS / FOR BUYERS: paper, the river edge on top -->
    <div class="relative bg-[#F3EFE6] text-[#1B2A33]">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="absolute -top-[79px] left-0 h-20 w-full" aria-hidden="true">
        <path d="M0 80 L0 40 C 240 0, 480 70, 720 40 S 1200 0, 1440 36 L1440 80 Z" fill="#F3EFE6" />
      </svg>

      <section class="mx-auto grid max-w-[1440px] gap-20 px-6 pb-24 pt-16 md:grid-cols-2 md:gap-16 md:px-12">
        <div id="proizvodaci" class="scroll-mt-10">
          <h2 class={h2}>{t.makers.h2} <em class={em}>{t.makers.h2em}</em></h2>
          <ul class="mt-10 max-w-xl space-y-5 text-lg leading-relaxed text-[#1B2A33]/80">
            {t.makers.items.map((s) => <li class={li}>{s}</li>)}
          </ul>
          <p class="mt-10 max-w-xl rounded-2xl bg-[#2C5A6E] px-6 py-5 text-lg leading-relaxed text-[#F3EFE6]">{t.makers.close}</p>
        </div>
        <div id="kupci" class="scroll-mt-10">
          <h2 class={h2}>{t.buyers.h2} <em class={em}>{t.buyers.h2em}</em></h2>
          <ul class="mt-10 max-w-xl space-y-5 text-lg leading-relaxed text-[#1B2A33]/80">
            {t.buyers.items.map((s) => <li class={li}>{s}</li>)}
          </ul>
        </div>
      </section>

      <!-- CATEGORIES -->
      <section id="kategorije" class="mx-auto max-w-[1440px] px-6 pb-28 pt-8 md:px-12">
        <h2 class={h2}>{t.cats.h2} <em class={em}>{t.cats.h2em}</em></h2>
        <ul class="mt-12 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
          {t.cats.list.map((c) => (
            <li class="border-t border-[#1B2A33]/20 py-6">
              <p class="text-[1.65rem] font-[720] leading-tight tracking-tight [font-stretch:82%]">{c.n}</p>
              <p class="mt-2 text-[15px] leading-relaxed text-[#1B2A33]/60">{c.d}</p>
            </li>
          ))}
          <li class="border-t border-[#1B2A33]/20 py-6">
            <p class="text-[15px] leading-relaxed text-[#1B2A33]/60">{t.cats.other}</p>
            <a href="#kontakt" class="mt-2 inline-block font-iserif text-[1.65rem] italic text-[#2C5A6E] underline decoration-1 underline-offset-4 hover:text-[#1B2A33]">{t.cats.otherCta} →</a>
          </li>
        </ul>
      </section>
    </div>

    <!-- EUDR -->
    <section id="eudr" class="bg-[#E6E6D9] py-24 text-[#1B2A33]">
      <div class="mx-auto max-w-[1440px] px-6 md:px-12">
        <p class="font-mono text-[11px] tracking-[0.06em] text-[#1B2A33]/50">{t.eudr.kicker}</p>
        <h2 class:list={[h2, 'mt-4']}>{t.eudr.h2} <em class={em}>{t.eudr.h2em}</em></h2>
        <div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-16">
          <div class="max-w-xl space-y-5 text-lg leading-relaxed text-[#1B2A33]/80">
            <p>{t.eudr.p1}</p>
            <p>{t.eudr.p2}</p>
          </div>
          <div class="max-w-xl self-start rounded-3xl border border-[#1B2A33]/15 bg-[#F3EFE6] p-6 md:p-8">
            <p class="text-lg leading-relaxed">{t.eudr.help}</p>
            <p class="mt-5 border-t border-dashed border-[#C98A00]/60 pt-5 text-[15px] leading-relaxed text-[#1B2A33]/70">{t.eudr.limit}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHO WE ARE + CONTACT -->
    <div class="bg-[#F3EFE6] text-[#1B2A33]">
      <section class="mx-auto max-w-[1440px] px-6 pb-8 pt-24 md:px-12">
        <div class="md:ml-[32%]">
          <h2 class={h2}>{t.about.h2} <em class={em}>{t.about.h2em}</em></h2>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-[#1B2A33]/75">{t.about.p1}</p>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-[#1B2A33]/75">{t.about.p2}</p>
          <a href={home} class="mt-6 inline-block font-iserif text-2xl italic text-[#2C5A6E] underline decoration-1 underline-offset-4 hover:text-[#1B2A33]">{t.about.link} ↗</a>
        </div>
      </section>

      <section id="kontakt" class="mx-auto max-w-[1440px] scroll-mt-6 px-6 pb-48 pt-24 md:px-12">
        <div class="md:ml-[32%]">
          <h2 class={h2}>{t.contact.h2} <em class={em}>{t.contact.h2em}</em></h2>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-[#1B2A33]/75">{t.contact.lead}</p>
          <dl class="mt-10 space-y-8">
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#1B2A33]/50">{t.contact.email}</dt>
              <dd class="mt-2"><a href={mail} class="break-all text-[clamp(1.9rem,4.4vw,3.6rem)] font-[720] leading-none tracking-tight underline decoration-[#2C5A6E] decoration-2 underline-offset-[0.18em] [font-stretch:80%] hover:text-[#2C5A6E]">{trade.email}</a></dd>
            </div>
            {trade.phone && (
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#1B2A33]/50">{t.contact.phone}</dt>
                <dd class="mt-2"><a href={`tel:${trade.phone.replace(/\s/g, '')}`} class="text-[clamp(1.9rem,4.4vw,3.6rem)] font-[720] leading-none tracking-tight [font-stretch:80%] hover:text-[#2C5A6E]">{trade.phone}</a></dd>
              </div>
            )}
          </dl>
          <p class="mt-10 max-w-xl font-mono text-[12px] leading-relaxed text-[#1B2A33]/55">{t.contact.langs}</p>
        </div>
      </section>
    </div>
  </main>

  <!-- FOOTER: same legal data as upanishad.hr (ZTD čl. 21) -->
  <footer class="relative bg-[#0B0F12] text-[#ECEAE3]/60">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="absolute -top-[79px] left-0 h-20 w-full" aria-hidden="true">
      <path d="M0 80 L0 40 C 240 0, 480 70, 720 40 S 1200 0, 1440 36 L1440 80 Z" fill="#0B0F12" />
    </svg>
    <div class="mx-auto grid max-w-[1440px] gap-10 px-6 pb-12 pt-10 font-mono text-[11px] leading-relaxed md:grid-cols-[1fr_1fr_160px] md:px-12">
      <div>
        <a href={home} class="text-[#ECEAE3] underline decoration-[#ECEAE3]/30 underline-offset-4 hover:decoration-[#ECEAE3]">{legal.name}</a><br />{legal.full}<br />{L.address}<br />{L.river}
        <br /><br /><a href={home} class="hover:text-[#ECEAE3]">{t.footer.company} ↗</a>
      </div>
      <div>{L.court} · MBS {legal.mbs}<br />OIB {legal.oib}<br />{L.capital}<br />{L.director}<br />{legal.bank}</div>
      <svg viewBox="0 0 160 160" class="w-40" aria-label={L.mapAria}>
        <path d="M80 -5 C 76 30, 96 55, 92 80 S 78 130, 94 165" fill="none" stroke="#2C5A6E" stroke-width="8" stroke-linecap="round" />
        <path d="M-5 76 C 25 72, 50 86, 66 83 S 84 79, 91 82" fill="none" stroke="#2C5A6E" stroke-width="4" stroke-linecap="round" />
        <circle cx="102" cy="92" r="3.5" fill="#ECEAE3" />
        <text x="108" y="96" font-size="11" font-family="Instrument Serif" font-style="italic" fill="#ECEAE3">Aljmaš</text>
      </svg>
    </div>
  </footer>
</div>

<style>
  .tr-pill-solid { border-radius: 999px; background: #ECEAE3; color: #0B0F12; transition: background 180ms; }
  .tr-pill-solid:hover { background: #9BE564; }
  .tr-pill-est { border-radius: 999px; color: #F2A900; outline: 1.5px dotted #F2A900; outline-offset: -1.5px; transition: all 180ms; }
  .tr-pill-est:hover { color: #0B0F12; background: #ECEAE3; outline-color: transparent; }
</style>
