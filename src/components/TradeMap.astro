---
// Schematic map for trade.upanishad.hr: Osijek, the Drava, Danube, Sava, Bosna and Drina, and a 200 km circle.
// Rivers are rough [lat, lon] polylines, projected and smoothed at build time; no JavaScript reaches the browser.
// Straight-line distances from Osijek (checked 2026-11-11): Novi Sad 94, Tuzla 113, Banja Luka 147, Belgrade 161,
// Sarajevo 190, Zagreb 213 km; Serbian border (Erdut) 29 km, BiH border (Sava at Orašje) 57 km.
import type { TradeStrings } from '../i18n/trade';

interface Props { t: TradeStrings['map'] }
const { t } = Astro.props;

type LL = [number, number];
const N = 46.45, W = 15.55, K = 110, KX = K * Math.cos((45.5 * Math.PI) / 180);
const p = ([lat, lon]: LL) => ({ x: (lon - W) * KX, y: (N - lat) * K });
const r1 = (n: number) => Math.round(n * 10) / 10;
const path = (ll: LL[]) => {
  const pts = ll.map(p);
  let d = `M${r1(pts[0].x)} ${r1(pts[0].y)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const a = pts[i - 1] ?? pts[i], b = pts[i], c = pts[i + 1], e = pts[i + 2] ?? c;
    d += ` C${r1(b.x + (c.x - a.x) / 6)} ${r1(b.y + (c.y - a.y) / 6)} ${r1(c.x - (e.x - b.x) / 6)} ${r1(c.y - (e.y - b.y) / 6)} ${r1(c.x)} ${r1(c.y)}`;
  }
  return d;
};

const rivers: { ll: LL[]; w: number }[] = [
  // Danube
  { w: 4.5, ll: [[46.45, 18.89], [46.18, 18.94], [45.99, 18.69], [45.85, 18.86], [45.7, 18.92], [45.55, 18.95], [45.42, 19.02], [45.33, 19.06], [45.27, 19.2], [45.22, 19.38], [45.24, 19.7], [45.25, 19.85], [45.13, 20.25], [44.85, 20.4], [44.82, 20.47], [44.84, 20.65], [44.67, 20.93], [44.72, 21.1]] },
  // Drava
  { w: 3, ll: [[46.38, 15.95], [46.31, 16.36], [46.28, 16.75], [46.3, 16.87], [46.12, 17.15], [45.96, 17.46], [45.86, 17.75], [45.77, 18.17], [45.7, 18.38], [45.565, 18.68], [45.55, 18.95]] },
  // Sava
  { w: 3.5, ll: [[45.84, 15.5], [45.79, 15.97], [45.68, 16.18], [45.47, 16.38], [45.27, 16.91], [45.15, 17.25], [45.15, 18.01], [45.06, 18.47], [45.07, 18.7], [44.88, 18.81], [44.91, 19.33], [44.97, 19.61], [44.76, 19.7], [44.66, 20.2], [44.82, 20.45]] },
  // Bosna
  { w: 2, ll: [[43.82, 18.27], [43.99, 18.18], [44.2, 17.91], [44.42, 18.01], [44.55, 18.1], [44.73, 18.09], [44.95, 18.3], [45.06, 18.47]] },
  // Drina
  { w: 2, ll: [[43.4, 18.75], [43.505, 18.775], [43.67, 18.98], [43.78, 19.29], [43.97, 19.57], [44.19, 19.37], [44.39, 19.1], [44.53, 19.22], [44.75, 19.25], [44.91, 19.33]] },
];

const osijek = p([45.555, 18.6955]);
const radius = 200 / 111.2 * K; // 200 km in px (north–south scale; the projection keeps it close to round)
type City = { n: string; ll: LL; dx: number; dy: number; a?: 'start' | 'middle' | 'end' };
const cities = ((list: City[]) => list.map((c) => ({ ...c, ...p(c.ll) })))([
  { n: 'Zagreb', ll: [45.815, 15.982], dx: 7, dy: 4 },
  { n: 'Novi Sad', ll: [45.267, 19.834], dx: 7, dy: -6 },
  { n: t.belgrade, ll: [44.8125, 20.461], dx: 0, dy: 18, a: 'middle' },
  { n: 'Banja Luka', ll: [44.772, 17.191], dx: 7, dy: 4 },
  { n: 'Tuzla', ll: [44.538, 18.676], dx: 7, dy: 4 },
  { n: 'Sarajevo', ll: [43.856, 18.413], dx: 7, dy: 4 },
]);
const countries = [
  { n: t.hungary, ll: [46.33, 17.75] as LL },
  { n: t.croatia, ll: [45.47, 17.25] as LL },
  { n: t.bih, ll: [44.3, 17.15] as LL },
  { n: t.serbia, ll: [44.3, 20.3] as LL },
].map((c) => ({ ...c, ...p(c.ll) }));
const lbl = (ll: LL) => p(ll);
const danube = lbl([45.98, 18.97]), drava = lbl([46.04, 17.02]), sava = lbl([45.33, 16.75]);
const ang = (160 * Math.PI) / 180;
const rl = { x: osijek.x + radius * Math.cos(ang) + 9, y: osijek.y + radius * Math.sin(ang) + 4 };
---

<figure class="m-0">
  <svg viewBox="0 0 424 330" class="block h-auto w-full" role="img" aria-label={t.aria}>
    <circle cx={r1(osijek.x)} cy={r1(osijek.y)} r={r1(radius)} fill="none" stroke="#F2A900" stroke-opacity="0.75" stroke-width="1.3" stroke-dasharray="2 6" stroke-linecap="round" />
    <g fill="none" stroke="#2C5A6E" stroke-linecap="round" stroke-linejoin="round">
      {rivers.map((r) => <path d={path(r.ll)} stroke-width={r.w} />)}
    </g>
    <g font-family="JetBrains Mono Variable, monospace" font-size="11" letter-spacing="2.5" fill="#ECEAE3" fill-opacity="0.4" text-anchor="middle">
      {countries.map((c) => <text x={r1(c.x)} y={r1(c.y)}>{c.n}</text>)}
    </g>
    <g font-family="Instrument Serif, serif" font-style="italic" font-size="13" fill="#6FB3CF" fill-opacity="0.85">
      <text x={r1(danube.x)} y={r1(danube.y)}>{t.danube}</text>
      <text x={r1(drava.x)} y={r1(drava.y)}>Drava</text>
      <text x={r1(sava.x)} y={r1(sava.y)}>Sava</text>
    </g>
    <g font-family="Instrument Serif, serif" font-size="15" fill="#ECEAE3" fill-opacity="0.85">
      {cities.map((c) => (
        <>
          <circle cx={r1(c.x)} cy={r1(c.y)} r="2.6" fill="#ECEAE3" />
          <text x={r1(c.x + c.dx)} y={r1(c.y + c.dy)} text-anchor={c.a ?? 'start'}>{c.n}</text>
        </>
      ))}
    </g>
    <circle cx={r1(osijek.x)} cy={r1(osijek.y)} r="9" fill="none" stroke="#ECEAE3" stroke-width="1.5" />
    <circle cx={r1(osijek.x)} cy={r1(osijek.y)} r="3.6" fill="#ECEAE3" />
    <text x={r1(osijek.x - 13)} y={r1(osijek.y - 9)} text-anchor="end" font-family="Instrument Serif, serif" font-style="italic" font-size="20" fill="#ECEAE3">Osijek</text>
    <text x={r1(rl.x)} y={r1(rl.y)} font-family="JetBrains Mono Variable, monospace" font-size="11" fill="#F2A900">{t.radius}</text>
  </svg>
  <figcaption class="mt-4 text-[15px] leading-relaxed text-[#ECEAE3]/70">{t.caption}</figcaption>
  <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.14em] text-[#ECEAE3]/35">{t.note}</p>
</figure>
